<script>
document.addEventListener("DOMContentLoaded", function () {
  function setupToggle(titleId, contentId) {
    const title = document.getElementById(titleId);
    const content = document.getElementById(contentId);
    if (!title || !content) return;

    const baseText = title.textContent.trim();
    title.textContent = baseText + " +";
    title.style.cursor = "pointer";
    title.style.userSelect = "none";

    title.addEventListener("click", function () {
      const isHidden = getComputedStyle(content).display === "none";
      content.style.display = isHidden ? "block" : "none";
      title.textContent = baseText + (isHidden ? " -" : " +");
    });
  }

  setupToggle("compQsTitle", "compQs");
  setupToggle("discussQsTitle", "discussQs");
});
</script></body></html>
